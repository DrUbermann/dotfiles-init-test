{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh

if [ ! -f "${HOME}/.config/chezmoi/key.txt" ]; then
    mkdir -p "${HOME}/.config/chezmoi"
    "${HOME}/bin/chezmoi" age decrypt --output {{ joinPath (dir .chezmoi.configFile) "key.txt" | quote }} --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
    chmod 600 {{ joinPath (dir .chezmoi.configFile) "key.txt" | quote }}
fi


{{- else -}}
#!/usr/bin/env pwsh
Write-Output "Running 'run_onchange_before_decrypt-private-key.ps1.tmpl' as a powershell script."

{{- end -}}

{{- "" }}
