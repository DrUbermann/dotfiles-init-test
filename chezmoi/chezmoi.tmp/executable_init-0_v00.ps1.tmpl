{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh

set -eu

cd "$(cd "$(dirname "$0")" && pwd)"

. ./.env

[ -n $LGR_LVL_CNSL ] && export LGR_LVL_CNSL
[ -n $LGR_LVL_FILE ] && export LGR_LVL_FILE



{{- else -}}
#!/usr/bin/env pwsh

Write-Output "Running 'executable_init-0.ps1.tmpl' as a powershell script." ############################################

## Equivalent of set -eu
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

Set-Location $PSScriptRoot

## Equivalent of . ./.env
$EnvFile = ".env"
if (Test-Path $EnvFile) {
    Get-Content $EnvFile | ForEach-Object {
        ## Clean up whitespace and skip empty lines or comments
        $line = $_.Trim()
        if ([string]::IsNullOrEmpty($line) -or $line.StartsWith("#")) { return }
        ## Case 1: Exported variables (e.g., export BAR=bar)
        if ($line -match '^export\s+(?<key>[^=]+)=(?<value>.*)$') {
            $key = $Matches['key'].Trim()
            $value = $Matches['value'].Trim("'`"" )  ## Strips outer quotes if present
            ## Create BOTH local variable and environment variable
            Set-Item "Env:$key" $value
            Set-Variable -Name $key -Value $value -Force
        }
        ## Case 2: Regular variables (e.g., FOO=foo)
        elseif ($line -match '^(?<key>[^=]+)=(?<value>.*)$') {
            $key = $Matches['key'].Trim()
            $value = $Matches['value'].Trim("'`"" )  ## Strips outer quotes if present
            ## Create local variable ONLY
            Set-Variable -Name $key -Value $value -Force
        }
    }
} else {
    Write-Warning "Could not find '${EnvFile}'."
}

if ((Test-Path variable:LGR_LVL_CNSL) -and ![string]::IsNullOrEmpty($LGR_LVL_CNSL)) { $Env:LGR_LVL_CNSL = $LGR_LVL_CNSL }
if ((Test-Path variable:LGR_LVL_FILE) -and ![string]::IsNullOrEmpty($LGR_LVL_FILE)) { $Env:LGR_LVL_FILE = $LGR_LVL_FILE }


$b_reboot = $false

function ModReg {
    param([string]$Path, [string]$Name, [object]$Value, [string]$Type = "DWord")
    if (Test-Path $Path) {
        $current = Get-ItemPropertyValue -Path $Path -Name $Name -ErrorAction SilentlyContinue
        if ($current -eq $Value) {
            return $false
        }
        Set-ItemProperty -Path $Path -Name $Name -Value $Value -Type $Type
        return $true
    } else {
        Write-Error "Registry path $Path not available."
        return $false
    }
}

#### Enable Developer Mode
$b_reboot = ModReg -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock" -Name "AllowDevelopmentWithoutDevLicense" -Value 1
$b_reboot = ModReg -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock" -Name "AllowAllTrustedApps" -Value 1



#### Enable Symbolic Link Creation
if (!(whoami /priv | Select-String "SeCreateSymbolicLinkPrivilege")) {
    ## Get the SID for the current user
    $sid = (New-Object System.Security.Principal.NTAccount($env:USERNAME)).Translate([System.Security.Principal.SecurityIdentifier]).Value

    $tmpCfg = "$env:TEMP\secpol.cfg"
    $tmpDb  = "$env:TEMP\secpol.db"

    ## Export current policy
    secedit /export /cfg $tmpCfg /quiet

    ## Add the user to SeCreateSymbolicLinkPrivilege
    $content = Get-Content $tmpCfg
    if ($content -match "SeCreateSymbolicLinkPrivilege") {
        $content = $content -replace "(SeCreateSymbolicLinkPrivilege\s*=\s*.*)", "`$1,*$sid"
    } else {
        $content += "`nSeCreateSymbolicLinkPrivilege = *$sid"
    }
    Set-Content $tmpCfg $content

    ## Import modified policy
    secedit /configure /db $tmpDb /cfg $tmpCfg /quiet

    ## Cleanup
    Remove-Item $tmpCfg, $tmpDb -Force -ErrorAction SilentlyContinue

    $b_reboot = $true
}



if $b_reboot {
    exit 3
} else {
    exit 0
}


{{- end -}}

{{- "" }}
